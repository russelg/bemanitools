FROM --platform=amd64 debian:12-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

LABEL description="Build environment for bemanitools"

# mingw-w64-gcc has 32-bit and 64-bit toolchains
RUN apt-get update && apt-get install -y --no-install-recommends \
    mingw-w64 \
    mingw-w64-common \
    make \
    zip \
    git \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir /bemanitools
WORKDIR /bemanitools

ENTRYPOINT [ \
    "/bin/sh", \
    "-c" , \
    "cd /bemanitools && \
    make" ]
